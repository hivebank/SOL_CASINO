# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRY=86400

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=casino

# Blockchain RPC URLs
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
ETH_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
ETH_NETWORK=goerli
ETH_CHAIN_ID=5

# Casino Escrow Wallets (for testnet mode)
SOLANA_ESCROW_ADDRESS=
ETH_ESCROW_ADDRESS=

# Rate Limiting
RATE_LIMIT_DEMO_TOPUP=10
RATE_LIMIT_BET=100
RATE_LIMIT_LOGIN=20

# Operating Mode (demo, testnet, production)
OPERATING_MODE=demo

# Demo Mode Settings
DEMO_INITIAL_BALANCE=10000
DEMO_TOPUP_AMOUNT=1000

# Payroll Settings
PAYROLL_ENABLED=true
PAYROLL_DAILY_AMOUNT=100
PAYROLL_MIN_ACTIVITY_THRESHOLD=5

# House Edge Defaults (percentage)
HOUSE_EDGE_SLOTS=5.0
HOUSE_EDGE_ROULETTE=2.7
HOUSE_EDGE_BLACKJACK=0.5

# Provably Fair
PROVABLY_FAIR_ENABLED=true
SERVER_SEED_ROTATION_DAYS=7

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
BCRYPT_ROUNDS=12
SESSION_LIFETIME=3600

# Admin Defaults (for seed script)
ADMIN_EMAIL=admin@casino.local
ADMIN_PASSWORD=Admin123!@#

# Logging
LOG_LEVEL=debug
LOG_FILE=../logs/casino.log
