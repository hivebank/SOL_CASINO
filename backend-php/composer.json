{
    "name": "casino/backend-php",
    "description": "PHP backend for Solana-ETH Casino Suite",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "mongodb/mongodb": "^1.17",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.8",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Casino\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Casino\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src/"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
